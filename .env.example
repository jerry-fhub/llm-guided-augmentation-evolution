# Optional. Only needed for configs with llm.provider: openai.
# Copy this file to .env and fill in local values. Do not commit real keys.
OPENAI_API_KEY=

# Optional. Leave blank or unset for the default OpenAI endpoint.
# Set this only for an OpenAI-compatible endpoint or proxy.
OPENAI_BASE_URL=

# The model is configured in each YAML file under llm.model, not here.
